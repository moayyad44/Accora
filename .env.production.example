# Copy to .env (repo root) before running `docker compose up -d`.
# docker-compose.yml reads these to configure the postgres + api containers.

# --- Postgres superuser (owns the DB, runs migrations) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=accora

# --- The app itself never connects as the superuser above — see
# apps/api/src/prisma/prisma.service.ts. On a brand-new database this MUST
# be exactly "change_me_in_production" (that's what the
# add_row_level_security migration sets for the app_user role it creates);
# rotate it right after first deploy with scripts/rotate-app-user-password.sh
# and update this value to match. ---
APP_USER_PASSWORD=change_me_in_production

# --- JWT signing secrets — generate real random values, e.g.:
# openssl rand -base64 48 ---
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Host port the API is published on ---
API_PORT=3000

# --- Host port the web app (the address employees open in their browser)
# is published on. 80 is the plain default (no ":port" needed in the URL);
# change it if something else on the machine already uses port 80. ---
WEB_PORT=80
