// ============================================================================
// MANUFACTURING: multi-level BOM, work centers, production orders. Posting a
// completed production order consumes raw-material stock and produces
// finished/semi-finished stock, with cost computed from material + labor +
// overhead (see CostingService, costing.prisma).
// ============================================================================

model Bom {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @db.Uuid
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemId    String   @db.Uuid // the finished or semi-finished item this BOM produces
  item      Item     @relation("BomOutputItem", fields: [itemId], references: [id])
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  lines            BomLine[]
  productionOrders ProductionOrder[]

  @@unique([companyId, itemId, version])
  @@map("boms")
}

/// A BOM line's component may itself be a semi-finished item with its own
/// active BOM, giving multi-level BOM explosion at production-planning time.
model BomLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bomId           String        @db.Uuid
  bom             Bom           @relation(fields: [bomId], references: [id], onDelete: Cascade)
  lineNumber      Int
  componentItemId String        @db.Uuid
  componentItem   Item          @relation("BomComponentItem", fields: [componentItemId], references: [id])
  qty             Decimal       @db.Decimal(18, 4)
  unitId          String        @db.Uuid
  unit            UnitOfMeasure @relation(fields: [unitId], references: [id])
  scrapPercent    Decimal       @default(0) @db.Decimal(5, 2)

  @@unique([bomId, lineNumber])
  @@map("bom_lines")
}

model WorkCenter {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @db.Uuid
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  nameAr      String?
  costPerHour Decimal @default(0) @db.Decimal(18, 4)
  isActive    Boolean @default(true)

  stages ProductionStage[]

  @@map("work_centers")
}

enum ProductionOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String                @db.Uuid
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderNumber          String
  bomId                String                @db.Uuid
  bom                  Bom                   @relation(fields: [bomId], references: [id])
  itemId               String                @db.Uuid
  item                 Item                  @relation(fields: [itemId], references: [id])
  warehouseId          String                @db.Uuid
  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id])
  plannedQty           Decimal               @db.Decimal(18, 4)
  status               ProductionOrderStatus @default(DRAFT)
  startDate            DateTime?             @db.Date
  endDate              DateTime?             @db.Date
  postedJournalEntryId String?               @db.Uuid
  createdAt            DateTime              @default(now())

  stages               ProductionStage[]
  materialConsumptions MaterialConsumption[]
  outputs              ProductionOutput[]
  byProducts           ByProduct[]
  costVariances        CostVariance[]

  @@unique([companyId, orderNumber])
  @@map("production_orders")
}

enum ProductionStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model ProductionStage {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String                @db.Uuid
  productionOrder   ProductionOrder       @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  workCenterId      String                @db.Uuid
  workCenter        WorkCenter            @relation(fields: [workCenterId], references: [id])
  sequence          Int
  status            ProductionStageStatus @default(PENDING)
  plannedHours      Decimal               @default(0) @db.Decimal(10, 2)
  actualHours       Decimal               @default(0) @db.Decimal(10, 2)

  @@unique([productionOrderId, sequence])
  @@map("production_stages")
}

/// Actual raw-material usage recorded against a production order (feeds
/// material cost into the order's total cost, and generates OUT stock moves).
model MaterialConsumption {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String          @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String          @db.Uuid
  item              Item            @relation(fields: [itemId], references: [id])
  qty               Decimal         @db.Decimal(18, 4)
  unitCost          Decimal         @db.Decimal(18, 4)
  consumedAt        DateTime        @default(now())

  @@map("material_consumptions")
}

/// Finished/semi-finished output recorded against a production order
/// (generates IN stock moves at computed unit cost).
model ProductionOutput {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String          @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String          @db.Uuid
  item              Item            @relation(fields: [itemId], references: [id])
  qty               Decimal         @db.Decimal(18, 4)
  unitCost          Decimal         @db.Decimal(18, 4)
  producedAt        DateTime        @default(now())

  @@map("production_outputs")
}

/// Secondary/by-products produced incidentally alongside the main output,
/// valued and put into stock at a (usually lower) recognized value.
model ByProduct {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productionOrderId String          @db.Uuid
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  itemId            String          @db.Uuid
  item              Item            @relation(fields: [itemId], references: [id])
  qty               Decimal         @db.Decimal(18, 4)
  value             Decimal         @db.Decimal(18, 4)

  @@map("by_products")
}
