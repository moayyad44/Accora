DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accora_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/accora_shadow?schema=public"

# The running application connects as this least-privilege role (created by
# the add_row_level_security migration), never as the superuser above.
RUNTIME_DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/accora_dev?schema=public"

JWT_ACCESS_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=3000
